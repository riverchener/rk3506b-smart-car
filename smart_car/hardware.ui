     <property name="styleSheet">
      <string notr="true">QCheckBox {
color: rgb(225, 238, 250);
font: 16pt &quot;Agency FB&quot;;
spacing: 14px;
padding: 6px 12px;
border-radius: 10px;
background: rgba(255, 255, 255, 16);
}
QCheckBox:hover {
background: rgba(255, 255, 255, 34);
}
QCheckBox::indicator {
width: 38px;
height: 38px;
border-radius: 7px;
border: 2px solid rgb(110, 145, 180);
background: rgb(24, 34, 48);
}
QCheckBox::indicator:checked {
background: rgb(70, 200, 130);
border: 2px solid rgb(120, 235, 165);
}</string>
