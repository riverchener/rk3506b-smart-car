#!/bin/sh
#
# bt-keystore-init —— 保证 BlueZ 的配对密钥目录指向持久分区
#
# 【本板的真实情况（实测确认）】
#   - /var/lib 是 **tmpfs**（由 S01overlayfs 挂载），重启清空
#   - 出厂已经把真正的持久存储设在 **/userdata/lib/bluetooth**
#     （里面有 adapter 目录 /var/lib/bluetooth/<控制器MAC>/settings 与 cache/）
#   - 所以正确做法是把 /var/lib/bluetooth 指向 /userdata/lib/bluetooth
#
# 【踩过的坑，别再犯】
#   我曾经把 /var/lib/bluetooth 指向了 /userdata/bluetooth ——
#   那是个**空的目录**，不是这个板的存储位置，等于把 BlueZ 的存储改到了错地方，
#   于是"配对成功"的密钥写进了没人看的地方，检查时永远是空的。
#   本板根本没有 /userdata/bluetooth 这个存储，正确的是 /userdata/lib/bluetooth。
#
# 必须在 bluetoothd 启动**之前**执行 —— 由 S39bt-keystore 调用（排在 S40 前面）。
set -u

PERSIST=/userdata/lib/bluetooth
LINK=/var/lib/bluetooth

mkdir -p "$PERSIST"
chmod 700 "$PERSIST"

if [ -L "$LINK" ]; then
    # 已经是符号链接：确保指向正确（可能指向错的旧路径）
    cur=$(readlink "$LINK")
    [ "$cur" = "$PERSIST" ] || ln -sfn "$PERSIST" "$LINK"
elif [ -d "$LINK" ]; then
    # 真实目录：把内容搬到持久区再改成符号链接，避免丢密钥
    cp -a "$LINK"/. "$PERSIST"/ 2>/dev/null
    rm -rf "$LINK"
    ln -sfn "$PERSIST" "$LINK"
else
    ln -sfn "$PERSIST" "$LINK"
fi

chmod 700 "$PERSIST"

# ---------------------------------------------------------------------------
# 把所有"已配对"的设备预先标成 Trusted=true。
#
# 【为什么必须在这里做，而不是开机后用 bluetoothctl trust】
# BlueZ 收到手机的 A2DP 入连接时会先问 agent"是否授权这个服务"
# （profiles/audio/a2dp.c:confirm_cb -> btd_request_authorization），
# 而 bluetoothctl 的 agent 只会打印 "Accept pairing (yes/no):" 等**人敲键盘**，
# 车机没人敲，实测挂着 41 秒后连接被拒 —— 手机侧就是"连接失败"。
#
# src/adapter.c:process_auth_queue() 的第一条分支是：
#     if (btd_device_is_trusted(device) == TRUE) { 直接放行 }
# 所以只要设备是 trusted，整个授权询问就被跳过。
#
# 实测过的坑：开机脚本里等 bluetoothd 起来再 `bluetoothctl trust <addr>` ——
# 那时候 bluetoothd 还没把设备从磁盘读进来（keystore 是异步 load 的），
# 命令等于打空，而且 bluetoothctl 失败也返回 0，脚本还会打出"已信任"的假日志。
# 结果重启后 info 里依然是 Trusted=false。
#
# 所以在**bluetoothd 启动之前**直接改配置文件，它一读进来就是 trusted，
# 没有任何竞态。
# ---------------------------------------------------------------------------
for info in "$PERSIST"/*/*/info; do
    [ -f "$info" ] || continue
    # 只处理真正配对过的（有 LinkKey），别把扫描到的临时设备也标上
    grep -q '^\[LinkKey\]' "$info" 2>/dev/null || continue
    if grep -q '^Trusted=' "$info" 2>/dev/null; then
        sed -i 's/^Trusted=.*/Trusted=true/' "$info"
    else
        # 没有这行就补到 [General] 段第一行
        sed -i '/^\[General\]/a Trusted=true' "$info"
    fi
done

exit 0

