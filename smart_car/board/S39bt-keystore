#!/bin/sh
#
# S39bt-keystore —— 在 bluetoothd 启动**之前**把 BlueZ 密钥目录指向持久分区
#
# 为什么必须是 S39（早于 S40bluetoothd）：
#   bluetoothd 启动时才会去读/建 /var/lib/bluetooth。如果那时它还不存在，
#   BlueZ 就没法保存配对密钥（本板 /var/lib 是 tmpfs，每次开机都是空的），
#   表现为"配对显示成功但密钥没落盘、重启后手机报通行密钥不正确"。
#
# 实际工作交给 /userdata/smart_car/bt-keystore-init

SETUP=/userdata/smart_car/bt-keystore-init
LOG=/var/log/smartcar-bt.log

start() {
    printf 'Starting bt-keystore: '
    if [ -x "$SETUP" ]; then
        "$SETUP" && echo "OK"
    else
        # 退路：直接在这里做，别让蓝牙因为脚本缺失而不能配对
        mkdir -p /userdata/bluetooth && chmod 700 /userdata/bluetooth
        [ -e /var/lib/bluetooth ] || ln -sfn /userdata/bluetooth /var/lib/bluetooth
        echo "OK (inline)"
    fi
    echo "$(date '+%m-%d %H:%M:%S') S39bt-keystore: $(ls -ld /var/lib/bluetooth 2>&1)" >> "$LOG"
    return 0
}

stop() {
    # 不需要做什么：密钥已经写在 /userdata 上
    printf 'Stopping bt-keystore: '
    echo "OK"
    return 0
}

case "$1" in
    start)   start ;;
    stop)    stop ;;
    restart|reload) stop; start ;;
    *) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
