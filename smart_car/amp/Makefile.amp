# SPDX-License-Identifier: BSD-3-Clause */
#
# Minimal build for the RK3506 M0 AMP service (sc_amp.c).
#
# The vendor Makefile also links the unity test framework, the coremark
# benchmark and the simple-console middleware.  Nothing in main.c reaches them,
# but between them they reference printf()/snprintf(), which drags newlib's
# whole vfprintf/dtoa machinery plus several KiB of static buffers into the
# image - and the M0 has only 32 KiB of RAM for text+rodata+data+bss+heap+stack.
# Dropping them is what makes room for the service, its console log and the
# rpmsg-lite heap.
#
# usage:  make -f Makefile.amp
#
PROJECT		:= RK3506
SOC		:= RK3506
ROOT_PATH	:= ../../..
HAL_PATH	:= $(ROOT_PATH)

CPU		:= -mcpu=cortex-m0 -mthumb

CROSS_COMPILE	?= $(ROOT_PATH)/../prebuilts/gcc/linux-x86/arm/gcc-arm-none-eabi-10-2020-q4-major-x86_64-linux/bin/arm-none-eabi-

AS		= $(CROSS_COMPILE)as
CC		= $(CROSS_COMPILE)gcc
NM		= $(CROSS_COMPILE)nm
OBJCOPY		= $(CROSS_COMPILE)objcopy
OBJDUMP		= $(CROSS_COMPILE)objdump
SIZE		= $(CROSS_COMPILE)size

# -Os (not the vendor's -O2): code lives in the very same 32 KiB of RAM as the
# heap and the stack, so every byte of text is a byte the service cannot use.
CFLAGS		:= -Os
CFLAGS		+= $(CPU) -std=c99 -g -ffunction-sections -fdata-sections
CFLAGS		+= -fno-asynchronous-unwind-tables -fno-unwind-tables
LDFLAGS		:= --specs=nosys.specs
LDFLAGS		+= -nostartfiles $(CPU) -Wl,--gc-sections -lc -lm -lgcc
OCFLAGS		= -R .note -R .note.gnu.build-id -R .comment -S

LINKER_SCRIPT	:= gcc_bus_m0.ld
BIN		:= TestDemo.bin
ELF		:= TestDemo.elf
MAP		:= TestDemo.map

HAL_CFLAGS	+= -Wformat=2 -Wall -Wno-unused-parameter
HAL_CFLAGS	+= -Wstrict-prototypes -Wmissing-prototypes -Wimplicit-fallthrough
HAL_CFLAGS	+= -Werror

#############################################################################
# Sources: our app, the HAL, the CMSIS device templates and rpmsg-lite only
#############################################################################
INCLUDES += \
-I"../src" \
-I"$(HAL_PATH)/lib/CMSIS/Core/Include" \

SRC_DIRS += \
    ../src \
    $(HAL_PATH)/lib/CMSIS/Device/$(SOC)/Source/Templates/GCC \

include $(HAL_PATH)/tools/build_lib.mk
SRC_DIRS += $(HAL_LIB_SRC)
INCLUDES += $(HAL_LIB_INC)

include ../../../middleware/rpmsg-lite/rpmsg-lite.mk

SRCS += $(basename $(foreach dir,$(SRC_DIRS),$(wildcard $(dir)/*.[cS])))
OBJS += $(addsuffix .o,$(basename $(SRCS)))
CFLAGS += $(INCLUDES)
ASFLAGS += $(CPU) -D__ASSEMBLY__ $(INCLUDES)

HAL_SRCS += $(basename $(foreach dir,$(HAL_LIB_SRC) $(HAL_PATH)/lib/CMSIS/Device/$(SOC)/Source/Templates/GCC,$(wildcard $(dir)/*.[cS])))
HAL_OBJS += $(addsuffix .o,$(basename $(HAL_SRCS)))
$(HAL_OBJS): CFLAGS += $(HAL_CFLAGS)

all: $(BIN)

$(ELF): $(OBJS) $(LINKER_SCRIPT)
	$(CC) $(OBJS) $(LDFLAGS) $(CFLAGS) -T$(LINKER_SCRIPT) -Wl,-Map=$(MAP),-cref -o $@
	$(SIZE) $@

$(BIN): $(ELF)
	$(OBJCOPY) $(OCFLAGS) -O binary $< $@
	ls -la $(BIN)

clean:
	rm -f $(OBJS) TestDemo*

.PHONY: all clean
